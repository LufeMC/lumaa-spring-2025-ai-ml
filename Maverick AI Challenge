import pandas as pd
import numpy as np
from sklearn.feature_extraction.text import TfidfVectorizer
from sklearn.metrics.pairwise import cosine_similarity
import argparse

def load_dataset():
    """Loads a small movie dataset with titles and descriptions."""
    data = {
        'title': [
            'Interstellar', 'Guardians of the Galaxy', 'The Martian',
            'Gravity', 'Star Wars: A New Hope', 'Thor: Ragnarok'
        ],
        'description': [
            'A team of explorers travel through a wormhole in space in an attempt to ensure humanity's survival.',
            'A group of intergalactic criminals must pull together to stop a fanatical warrior with plans to purge the universe.',
            'An astronaut becomes stranded on Mars and must rely on his ingenuity to survive and find a way to signal Earth.',
            'Two astronauts work together to survive after an accident leaves them stranded in space.',
            'Luke Skywalker joins forces with a Jedi Knight, a cocky pilot, a Wookiee, and two droids to save the galaxy from the Empire.',
            'Thor is imprisoned on the planet Sakaar and must race against time to return to Asgard and stop Ragnarok.'
        ]
    }
    return pd.DataFrame(data)

def recommend_movies(query, top_n=5):
    """Recommends top N movies based on content similarity."""
    df = load_dataset()
    
    # Vectorize text using TF-IDF
    vectorizer = TfidfVectorizer(stop_words='english')
    tfidf_matrix = vectorizer.fit_transform(df['description'])
    
    # Transform user query into vector
    query_vec = vectorizer.transform([query])
    
    # Compute cosine similarity
    cosine_sim = cosine_similarity(query_vec, tfidf_matrix).flatten()
    
    # Get top N similar movies
    top_indices = cosine_sim.argsort()[-top_n:][::-1]
    recommendations = df.iloc[top_indices]
    
    return recommendations[['title', 'description']]

if __name__ == "__main__":
    parser = argparse.ArgumentParser(description="Movie Recommendation System")
    parser.add_argument("query", type=str, help="User description of movie preference")
    args = parser.parse_args()
    
    results = recommend_movies(args.query)
    print(results)
